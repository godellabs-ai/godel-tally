# Development/source-run configuration (KEY=value, no shell quoting or expansion).
# The customer installer writes ~/.godel-tally/config/tally.env instead.
# make dev: https://localhost:8080; make run: https://localhost:2357
# TALLY_URL=https://localhost:2357
# TALLY_HTTP_BIND=127.0.0.1:2357
# TALLY_TLS_CERT_FILE=/absolute/path/to/fullchain.pem
# TALLY_TLS_KEY_FILE=/absolute/path/to/privkey.pem
# TALLY_SECRET_KEY=<64 lowercase hex; generated once, keep stable>

# Native cargo/Node development with Docker DBs by default.
TALLY_DEV_BIND=127.0.0.1:8080
TALLY_ALLOWED_DEV_ORIGINS=
# TALLY_DB_MODE=docker
# TALLY_DB_MODE=apple
# Set modes independently when mixing managed and existing databases:
# TALLY_POSTGRES_MODE=existing
# TALLY_CLICKHOUSE_MODE=docker
# TALLY_POSTGRES_URL=postgres://user:encoded-password@127.0.0.1:5433/tally
# TALLY_CLICKHOUSE_URL=http://127.0.0.1:8124?user=tally
# TALLY_CLICKHOUSE_PASSWORD=tally-local
# TALLY_CLICKHOUSE_DATABASE=tally
TALLY_AI_LOG_RETENTION_DAYS=90
TALLY_IDENTITY_HISTORY_RETENTION_DAYS=365
# Compose UI upgrades require a local engine socket and a dedicated, writable host directory.
# TALLY_DOCKER_SOCKET=/var/run/docker.sock
# TALLY_DEPLOYMENT_ROOT=/absolute/host/path/tally-deploy
# Existing mode requires dedicated PostgreSQL and ClickHouse databases already created.
# Tally runs migrations on both stores. Use accounts with DDL permissions.

# Optional initial email delivery. Settings -> Email delivery overrides these values, including
# an explicit disable. Set TALLY_URL above before requesting emailed password-reset links.
# EMAIL_ENABLED=true
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=tally@example.com
# EMAIL_FROM_NAME=Gödel Tally
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# SES also supports the host AWS credential chain when the explicit keys are empty.
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_API_KEY=
# POSTMARK_SERVER_TOKEN=
