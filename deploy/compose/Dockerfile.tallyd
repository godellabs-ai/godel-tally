# source (default) compiles tallyd in the image build. prebuilt packages static binaries supplied
# with --build-context tallyd-binaries=DIR as DIR/linux-<arch>/tallyd; scripts/push-image.sh uses it.
ARG TALLYD_BINARY_STAGE=source

FROM node:24-bookworm-slim AS web
WORKDIR /src/apps/web
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM rust:1.99.0-alpine AS builder
RUN apk add --no-cache build-base clang cmake perl linux-headers
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS
WORKDIR /src
COPY . .
COPY --from=web /src/apps/web/out ./apps/web/out
RUN cargo run --locked -p tally-registry-cli -- build \
      --source registry-data/source --output registry-data/dist \
    && target="$(rustc -vV | sed -n 's/^host: //p')" \
    && cargo build --locked --profile container -p tallyd --features embedded-ui --target "$target" \
    && cp "target/$target/container/tallyd" /tallyd

FROM --platform=$BUILDPLATFORM debian:trixie-slim AS runtime-files
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && mkdir -p /rootfs/data /rootfs/tmp \
    && chmod 1777 /rootfs/tmp \
    && chown 65532:65532 /rootfs/data

FROM debian:trixie-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl python3 openssl coreutils findutils sed gawk grep \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian trixie stable\n' "$(dpkg --print-architecture)" > /etc/apt/sources.list.d/docker.list \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /etc/apt/keyrings/postgresql.asc \
    && printf 'deb [signed-by=/etc/apt/keyrings/postgresql.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main\n' > /etc/apt/sources.list.d/postgresql.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 tally && useradd --uid 65532 --gid tally --home-dir /data --no-create-home --shell /usr/sbin/nologin tally
COPY scripts/ /opt/tally/scripts/
COPY docker-compose.yml docker-compose.dev.yml /opt/tally/
LABEL org.opencontainers.image.source="https://github.com/godellabs-ai/godel-tally" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=runtime-files /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=runtime-files /rootfs/ /
ENV TALLY_UPGRADE_TALLY_ROOT=/opt/tally TALLY_BINARY=/usr/local/bin/tallyd HOME=/data SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
WORKDIR /data
EXPOSE 2357
# Starts as root only to stage a supplied certificate, then runs tallyd as 65532.
ENTRYPOINT ["/usr/local/bin/tallyd"]
CMD ["container"]
HEALTHCHECK --interval=5s --timeout=10s --start-period=30s --retries=60 \
    CMD ["/usr/local/bin/tallyd", "healthcheck"]

FROM runtime AS source
COPY --from=builder /tallyd /usr/local/bin/tallyd

# Placeholder replaced by --build-context tallyd-binaries=DIR.
FROM scratch AS tallyd-binaries

FROM runtime AS prebuilt
ARG TARGETARCH
COPY --from=tallyd-binaries linux-${TARGETARCH}/tallyd /usr/local/bin/tallyd

FROM ${TALLYD_BINARY_STAGE}
