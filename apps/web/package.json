{
  "name": "godel-tally-web",
  "version": "0.1.2",
  "private": true,
  "description": "Web console for the Gödel Tally AI inventory and governance service",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godellabs-ai/godel-tally.git",
    "directory": "apps/web"
  },
  "homepage": "https://github.com/godellabs-ai/godel-tally#readme",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p ${TALLY_WEB_PORT:-8080} -H ${TALLY_WEB_HOST:-127.0.0.1}",
    "build": "node scripts/build-static.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p ${TALLY_WEB_PORT:-8080} -H ${TALLY_WEB_HOST:-127.0.0.1}",
    "e2e": "playwright test",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "unrs-resolver@1.12.2": true
  }
}
