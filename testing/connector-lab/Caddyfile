# LiteLLM's native pull requires an HTTPS origin (Tally refuses plain HTTP), so a
# real TLS terminator sits in front of the real LiteLLM proxy, exactly as an
# operator would deploy it.
{
    admin off
    auto_https off
}

https://litellm.lab:443 {
    tls /certs/server.pem /certs/server.key
    reverse_proxy litellm:4000
}
